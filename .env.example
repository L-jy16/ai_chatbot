# 세션 쿠키 서명 키 (필수, 16자 이상)
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# DB 연결 주소 (기본값: sqlite:///./app.db)
DATABASE_URL=sqlite:///./app.db

# 네이버 API (B) — 네이버 클라우드 플랫폼 NAVER API HUB Application의 키(뉴스 검색·검색어 트렌드 API를 켜 둘 것)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_TIMEOUT_SECONDS=5

# LLM API (C)
LLM_API_KEY=
LLM_BASE_URL=https://copa.codyssey.kr/v1
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=50

# API 문서(/docs, /redoc, /openapi.json) 접속 계정 (A). 둘 다 채워야 문서가 열리고, 비우면 404로 숨긴다.
# 브라우저 로그인 창(HTTP Basic 인증)으로 묻는다. 영문·숫자·기호만 쓸 수 있다.
# HTTP 서버에서는 이 값이 암호화되지 않고 전송되므로 다른 곳에 쓰지 않는 비밀번호로 정한다.
DOCS_USERNAME=
DOCS_PASSWORD=

# 운영자 DB 조회 화면(/admin) 접속 계정 (A). 둘 다 채워야 열리고, 비우면 404로 숨긴다.
# 사용자 데이터를 보는 화면이라 API 문서 계정과 따로 둔다. 영문·숫자·기호만 쓸 수 있다.
ADMIN_USERNAME=
ADMIN_PASSWORD=
